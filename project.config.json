{
  "project": "art-studio",
  "repos": [
    {
      "name": "art-studio",
      "path": ".",
      "traits": [
        "docs"
      ]
    }
  ],
  "sensitive": false,
  "public": false,
  "kitUpstream": "sigurd0414/agent-office",
  "containerDirs": [
    "specs",
    "docs",
    "tools",
    "tests"
  ],
  "gatedPaths": [],
  "checks": [
    "links"
  ],
  "branchPattern": "task/art-studio-{N}",
  "fileLineLimits": {
    "soft": 1200,
    "hard": 1800
  },
  "workerLimits": {
    "maxTickets": 3,
    "maxBusinessLines": 2000,
    "rotateAfterTickets": 12,
    "rotateAfterHours": 8,
    "heartbeatAliveMinutes": 15
  },
  "codeRules": {
    "headerTags": [
      "@module",
      "@role",
      "@forbid"
    ],
    "forbiddenPatterns": [],
    "generatedPaths": []
  },
  "docRules": {
    "registries": [
      {
        "id": "adr",
        "files": "docs/adr/ADR-*.md",
        "when": "狀態.*已接受",
        "mustAppearIn": [
          "docs/decisions.md"
        ],
        "pending": {
          "when": "狀態.*(提議中|草案)",
          "maxDays": 14
        }
      },
      {
        "id": "spec",
        "files": "specs/S-*.md",
        "mustAppearIn": [
          "docs/roadmap.md"
        ]
      },
      {
        "id": "skill",
        "files": "skills/*.md",
        "when": "^\\| 版本 \\|",
        "mustAppearIn": [
          "skills/README.md"
        ]
      },
      {
        "id": "prompt-template",
        "files": "prompts/*.md",
        "when": "^\\| 版本 \\|",
        "mustAppearIn": [
          "prompts/README.md"
        ]
      },
      {
        "id": "prompt-batch",
        "files": "prompts/batches/*.md",
        "when": "需求來源",
        "mustAppearIn": [
          "prompts/README.md"
        ]
      },
      {
        "id": "style",
        "files": "styles/*.md",
        "when": "^\\| 版本 \\|",
        "mustAppearIn": [
          "styles/README.md"
        ]
      }
    ]
  },
  "acceptCommands": []
}
