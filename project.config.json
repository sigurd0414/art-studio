{
  "project": "art-studio",
  "repos": [
    {
      "name": "art-studio",
      "path": ".",
      "traits": [
        "docs"
      ]
    }
  ],
  "sensitive": false,
  "public": false,
  "containerDirs": [
    "specs",
    "docs",
    "tools",
    "tests"
  ],
  "gatedPaths": [],
  "checks": [
    "links"
  ],
  "branchPattern": "task/art-studio-{N}",
  "fileLineLimits": {
    "soft": 1200,
    "hard": 1800
  },
  "workerLimits": {
    "maxTickets": 3,
    "maxBusinessLines": 2000,
    "rotateAfterTickets": 12,
    "rotateAfterHours": 8,
    "heartbeatAliveMinutes": 15
  },
  "codeRules": {
    "headerTags": [
      "@module",
      "@role",
      "@forbid"
    ],
    "forbiddenPatterns": [],
    "generatedPaths": []
  },
  "docRules": {
    "registries": [
      {
        "id": "adr",
        "files": "docs/adr/ADR-*.md",
        "when": "狀態.*已接受",
        "mustAppearIn": [
          "docs/decisions.md"
        ],
        "pending": {
          "when": "狀態.*(提議中|草案)",
          "maxDays": 14
        }
      },
      {
        "id": "spec",
        "files": "specs/S-*.md",
        "mustAppearIn": [
          "docs/roadmap.md"
        ]
      }
    ]
  },
  "acceptCommands": []
}
